function sumNestedNumbers(arr,level=1) {
  let total = 0;
    for (let item of arr) {
        if (Array.isArray(item)) {
            total += sumNestedNumbers(item, level + 1);
        } else {
            total += Math.pow(item, level);
        }
    }
    return total;
}
