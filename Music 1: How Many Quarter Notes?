function findQuarterNotes(timeSignature) {
const [top, bottom] = timeSignature.split('/').map(Number);
    
    if (bottom <= 0 || (bottom & (bottom - 1)) !== 0 || top < 1 || top >= 4096 || bottom >= 256) {
        return null;
    }
    
    const quarterNotes = (top * 4) / bottom;
    
    return Math.floor(Math.max(quarterNotes, 0));
}
