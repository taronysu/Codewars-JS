function continuedFraction(numerator,denominator) {
 if (numerator === 0) {
        return [];
    }
    
    const result = [];
    while (denominator) {
        const quotient = Math.floor(numerator / denominator);
        result.push(quotient);
        [numerator, denominator] = [denominator, numerator - quotient * denominator];
    }
    
    return result;
}
