function wordsToHex(w) {
const words = w.split(' ');
    const hexColors = [];

    for (const word of words) {
        let hexValue = '';
        for (const char of word.slice(0, 3)) {
            hexValue += char.charCodeAt(0).toString(16).padStart(2, '0');
        }
        if (word.length < 3) {
            hexValue += '00'.repeat(3 - word.length);
        }
        hexColors.push(`#${hexValue}`);
    }

    return hexColors;
}
