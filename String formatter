function StringFormatter(rules){
    return function(inputString) {
        let formattedString = inputString;

        if (rules.remove) {
            formattedString = formattedString.split('').filter(char => !rules.remove.includes(char)).join('');
        }

        if (rules.map) {
            formattedString = formattedString.split('').map(rules.map).join('');
        }

        if (rules.filter) {
            formattedString = formattedString.split('').filter(rules.filter).join('');
        }

        return formattedString;
    };
}
