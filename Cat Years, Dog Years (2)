let  ownedCatAndDog = function(catYears, dogYears) {
    function theHumanAge( years, n) {
        return years < 15 ? 0 : years < 24 ? 1 :  2 + (years - 24) / n;
      }
  return [Math.floor(theHumanAge(catYears, 4)), Math.floor(theHumanAge(dogYears, 5))];    
}
