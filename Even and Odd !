function evenAndOdd(n){
let even = [...String(n)].filter(el => el % 2 === 0).join('');
    let odd = [...String(n)].filter(el => el % 2 !== 0).join('');
    
    if (even.startsWith('0')) {
        even = even.replace(/^0+/, '');
    }
    if (odd.startsWith('0')) {
        odd = odd.replace(/^0+/, '');
    }
    
    if (odd === '') {
        odd = 0;
    }
    if (even === '') {
        even = 0;
    }
    
    return [parseInt(even), parseInt(odd)];
}
