function pascalsTriangle(n) {
 let pRow = [];
    let fRows = [];
    for (let x = 0; x < n; x++) {
        let nextRow = [1].concat(pRow.map((_, i) => (pRow[i] || 0) + (pRow[i + 1] || 0)));
        fRows = fRows.concat(nextRow);
        pRow = nextRow;
    }
    return fRows;
}
