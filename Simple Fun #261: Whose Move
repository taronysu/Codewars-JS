function whoseMove(lp, win) {
if (lp === 'black' && win === false) {
        return 'white';
    } else if (lp === 'white' && win === false) {
        return 'black';
    } else if (lp === 'black' && win === true) {
        return 'black';
    } else if (lp === 'white' && win === true) {
        return 'white';
    }   
}
