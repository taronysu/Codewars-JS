function split(str,mask) {
const totalLength = mask.reduce((acc, len) => acc + len, 0);
    if (totalLength !== str.length) return null;

    let result = [];
    let startIndex = 0;

    for (let len of mask) {
        result.push(str.slice(startIndex, startIndex + len));
        startIndex += len;
    }

    return result;
}
